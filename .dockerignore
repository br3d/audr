# Git
.git
.gitignore

# SSH keys and credentials
id_ed25519*
*.pem
*.key
.env
.env.*
!.env.example

# Python dev artifacts
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node dev artifacts
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docs and specs
docs/
specs/
*.md
README*

# Tests (not needed in production image)
tests/
backend/tests/
frontend/src/**/*.test.*
frontend/src/**/*.spec.*

# Local volumes
docker/volumes/
volumes/
postgres_data/

# Logs
*.log
logs/
