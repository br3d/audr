{
  "name": "saas-app",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS application server with a health-check endpoint. CI/CD-ready scaffold.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.9.0"
  }
}
