{
  "name": "saas-app",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS application server with a health-check endpoint. CI/CD-ready scaffold.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "lint": "eslint .",
    "test": "node --require ./tests/setup.js --test",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "csrf-sync": "^4.2.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "supertest": "^7.3.0"
  }
}
