# Deployment targets for the scripts/ helpers — copy to `deploy.env` (untracked)
# and fill in your own infrastructure. Everything here can equally be passed as
# environment variables; the environment wins over this file.
#
#   cp deploy.env.example deploy.env
#
# Nothing in this file is a secret. Credentials live in the deploy host's own
# `.env` / `secrets/` (see docs/deploy-runbook.md) and never in the repository.

# Container registry that holds the audr-backend image, as docker addresses it.
# Also read by compose.deploy.yaml — the private-registry overlay — so the
# deploy host's own .env needs it too (scripts/deploy.sh writes it there).
AUDR_REGISTRY=registry.example.internal:5000

# SSH destination of the deploy host, user@host.
AUDR_DEPLOY_HOST=deploy@audr.example.internal

# Private key used for that SSH connection, relative to the repo root or absolute.
AUDR_SSH_KEY=./id_ed25519

# Directory on the deploy host holding compose.yaml, compose.deploy.yaml, .env
# and secrets/.
AUDR_REMOTE_DIR=/home/deploy/audr

# Public base URL of the deployed stack, used by scripts/smoke-test.sh.
AUDR_BASE_URL=http://audr.example.internal
