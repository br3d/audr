<%- include('partials/header', { title: 'Forgot password', currentUser: null }) %>
<div class="card">
  <h1>Reset your password</h1>
  <% if (sent) { %>
    <div class="alert ok">If an account exists for that email, a reset link is on its way. Check your inbox.</div>
    <div class="links-row"><span></span><a href="/login">Back to sign in</a></div>
  <% } else { %>
    <p class="sub">Enter your email and we'll send you a reset link.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form action="/forgot-password" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>" />
      <button type="submit">Send reset link</button>
    </form>
    <div class="links-row"><span></span><a href="/login">Back to sign in</a></div>
  <% } %>
</div>
<%- include('partials/footer') %>
