<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Onboarding SaaS' %></title>
  <style>
    :root { --fg:#1a1a2e; --muted:#6b7280; --accent:#4f46e5; --err:#b91c1c; --ok:#047857; --border:#e5e7eb; }
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; color: var(--fg); background: #f8fafc; }
    header.nav { display:flex; justify-content:space-between; align-items:center; padding:14px 24px; background:#fff; border-bottom:1px solid var(--border); }
    header.nav a { color: var(--fg); text-decoration:none; font-weight:600; }
    header.nav .links a { margin-left:16px; font-weight:500; color: var(--muted); }
    main { max-width: 440px; margin: 48px auto; padding: 0 20px; }
    .card { background:#fff; border:1px solid var(--border); border-radius:12px; padding:28px; }
    h1 { font-size: 1.4rem; margin: 0 0 6px; }
    p.sub { color: var(--muted); margin: 0 0 20px; }
    label { display:block; font-size:.85rem; font-weight:600; margin:14px 0 6px; }
    input[type=email], input[type=password], input[type=text] { width:100%; padding:10px 12px; border:1px solid var(--border); border-radius:8px; font-size:1rem; }
    button { margin-top:18px; width:100%; padding:11px; background:var(--accent); color:#fff; border:0; border-radius:8px; font-size:1rem; font-weight:600; cursor:pointer; }
    button.danger { background:var(--err); }
    button.secondary { background:#fff; color:var(--fg); border:1px solid var(--border); }
    .alert { padding:10px 12px; border-radius:8px; font-size:.9rem; margin-bottom:16px; }
    .alert.error { background:#fef2f2; color:var(--err); border:1px solid #fecaca; }
    .alert.ok { background:#ecfdf5; color:var(--ok); border:1px solid #a7f3d0; }
    .links-row { margin-top:16px; font-size:.9rem; display:flex; justify-content:space-between; }
    a { color: var(--accent); }
    fieldset { border:1px solid var(--border); border-radius:10px; margin:0 0 20px; padding:16px 18px; }
    legend { font-weight:600; padding:0 6px; }
    hr { border:0; border-top:1px solid var(--border); margin:24px 0; }
  </style>
</head>
<body>
  <header class="nav">
    <a href="/">Onboarding SaaS</a>
    <div class="links">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/account">Account</a>
        <a href="/dashboard">Dashboard</a>
        <form action="/logout" method="post" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" style="width:auto;margin:0;padding:6px 12px;background:none;color:var(--muted);border:0;cursor:pointer;font-weight:500">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/signup">Sign up</a>
      <% } %>
    </div>
  </header>
  <main>
