  <h1><%= heading %></h1>
  <p class="sub"><%= body %></p>
  <% if (typeof link !== 'undefined' && link) { %>
    <a href="<%= link.href %>"><%= link.label %></a>
  <% } %>
</div>
<%- include('partials/footer') %>
