# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
# The dev/start scripts auto-load `.env` if present (node --env-file-if-exists).
# Never commit your real `.env` — it is gitignored.

# Port the HTTP server binds to (host platforms inject this in production).
PORT=3000

# Logical environment name surfaced in logs and the /health payload.
APP_ENV=development

# Node runtime environment (development | production | test). Controls secure
# cookies, trust proxy, and the session store backend.
NODE_ENV=development

# Human-friendly service name reported by /health.
SERVICE_NAME=saas-app

# Deployed commit SHA, surfaced by /health for "what's live?" checks.
# Left blank locally; set by CI/CD at deploy time.
GIT_SHA=

# Public base URL, used to build absolute password-reset links in emails.
APP_URL=http://localhost:3000

# --- Auth / sessions ---
# SQLite database file for users, sessions, and password-reset tokens.
# Use an absolute path or a mounted volume in production. ":memory:" for tests.
# (The data layer in src/db.js is isolated so this can move to Postgres via
#  DATABASE_URL below without touching route/service code.)
AUTH_DB_PATH=./data/app.db

# bcrypt cost factor (higher = slower = more resistant to brute force).
BCRYPT_ROUNDS=12

# Password-reset token lifetime in milliseconds (default 1h).
RESET_TOKEN_TTL_MS=3600000

# --- Email (password reset) ---
# If unset, reset emails are NOT sent; the reset link is logged to stdout so
# local development works without an SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@onboarding-saas.local

# --- Secrets ---
# Set real values locally only. In staging/production these live ONLY in the
# host secret store (Render dashboard env vars), never in git and never logged.
# DATABASE_URL is reserved for the future Postgres migration of the auth data
# layer (currently SQLite via AUTH_DB_PATH).
DATABASE_URL=postgres://user:password@localhost:5432/saas_app
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Notes ---
# Rate limiting uses an in-memory store (fine for a single instance). For a
# multi-instance deployment, back express-rate-limit with a shared Redis store.
