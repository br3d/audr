# typescript-eslint@8.72 peer-requires typescript <6.1; this project is on
# typescript@7.0.2 (tsc -b / vite build). typescript-eslint itself refuses to
# load against TS 7 at runtime (see AUD-696 issue comments), so this flag
# only unblocks `npm ci`/`npm install` — it does not make `npm run lint` work.
#
# This also disables npm's auto-install of *other* unmet peer deps, so any
# peer-only runtime dependency (e.g. recharts' react-is peer) must be listed
# explicitly in package.json rather than relying on npm to add it silently.
legacy-peer-deps=true
